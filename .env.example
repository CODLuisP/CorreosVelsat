# Copia este archivo como .env junto a docker-compose.yml y completa los valores.
# .env NO se sube a git. docker compose lo pasa al contenedor con env_file.
# Formato: Seccion__Clave (equivale a "Seccion": { "Clave": ... } en appsettings.json).

# --- Base de datos de la cola cola_correos (MySQL) ---
ConnectionStrings__MySql=Server=HOST;Port=25060;Database=gts;User=USUARIO;Password=CONTRASENA;SslMode=Required;

# --- Cloudflare Email Sending (obligatorias) ---
Cloudflare__AccountId=
# Token con permiso "Email Sending: Edit"
Cloudflare__ApiToken=
# Destinatarios por día (hora de Lima) antes de rotar a Brevo
Cloudflare__DailyLimit=100

# --- Brevo por SMTP (segundo proveedor, opcional) ---
Smtp__Enabled=false
Smtp__Host=smtp-relay.brevo.com
# 2525 con STARTTLS: DigitalOcean bloquea 25, 465 y 587
Smtp__Port=2525
# Login y clave SMTP de Brevo (Configuración > SMTP y API)
Smtp__User=
Smtp__Password=
Smtp__DailyLimit=300
# Si se define, cuando Brevo lleva 25 días sin enviar se manda una prueba a esta dirección (Brevo desactiva la clave a los 90)
Smtp__KeepAliveTo=

# --- Remitente ---
Email__DefaultFrom=alertas@velsat.pe
Email__DefaultFromName=Velsat Alertas
# Dominios permitidos en "from", separados por comas
Email__AllowedFromDomains=velsat.pe
Email__TimeoutMs=15000
Email__MaxRetries=3

# --- API POST /api/email/send (obligatoria, mínimo 24 caracteres; genera con: openssl rand -hex 32) ---
Api__ApiKey=
Api__RateLimitPerMinute=30
Api__RateLimitPerDay=2000
# Swagger UI en /correos/swagger
Api__SwaggerEnabled=false

# --- Worker de la cola ---
# true SOLO cuando el MailWorker anterior (servidor Windows) esté detenido, o habrá correos duplicados
Worker__Enabled=false
Worker__IntervalSeconds=60
Worker__BatchSize=10
Worker__MaxRetries=5

# --- Prefijo de ruta detrás de nginx (https://do.velsat.pe:8443/correos/) ---
PathBase=/correos
