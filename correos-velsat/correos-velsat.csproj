<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Los comentarios /// de los modelos se publican como descripciones en OpenAPI/Swagger. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="MySql.Data" Version="9.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <!-- MySql.Data 9.5.0 trae transitivamente 10.0.0, con vulnerabilidades conocidas (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="correos-velsat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json tiene secretos y es propio de cada entorno: se usa al ejecutar en local,
         pero no se publica, para no pisar el appsettings.json que ya existe en el servidor. -->
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <!-- La plantilla es solo documentación. -->
    <Content Update="appsettings.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
